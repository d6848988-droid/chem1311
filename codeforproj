<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Periodic Table</title>
<style>
:root { color-scheme: dark; font-family: Arial, sans-serif; background: #080808; color: #fff; }
* { box-sizing: border-box; }
body { margin: 0; }
main { max-width: 1500px; margin: auto; padding: 36px 24px; }
section { overflow-x: auto; padding: 16px 8px; }
.rect { display: grid; grid-template-columns: repeat(18, minmax(0, 1fr)); grid-template-rows: repeat(9, 66px); gap: 5px; min-width: 950px; }
.element { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px; background: #151515; color: #fff; border: 1px solid #555; border-radius: 4px; cursor: pointer; font: inherit; }
.element:hover, .element:focus-visible, .element.selected { background: #fff; color: #000; border-color: #fff; outline: 2px solid #fff; outline-offset: 2px; z-index: 2; }
.number { position: absolute; top: 4px; left: 5px; font-size: 10px; }
.symbol { font-size: 22px; font-weight: 600; }
.name { font-size: 8px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
.circular-section { border-top: 1px solid #333; margin-top: 64px; padding-top: 48px; padding-bottom: 48px; }
.circle { position: relative; width: 1000px; height: 1000px; margin: auto; }
.circle .element { position: absolute; width: 48px; height: 48px; transform: translate(-50%, -50%); border-radius: 50%; }
.circle .number { position: static; font-size: 9px; line-height: 11px; }
.circle .symbol { font-size: 17px; line-height: 20px; }
.ring { position: absolute; border: 1px solid #292929; border-radius: 50%; transform: translate(-50%, -50%); left: 50%; top: 50%; pointer-events: none; }
.details { display: block; min-height: 44px; margin: 20px 8px 0; color: #eee; font-size: 18px; line-height: 1.6; }
@media (max-width: 650px) { main { padding: 16px 8px; } .circular-section { margin-top: 32px; } }
.quiz { border-top: 1px solid #333; padding: 36px 8px; }
.quiz form { max-width: 720px; margin: auto; }
.quiz fieldset { margin: 0 0 24px; padding: 18px; border: 1px solid #555; border-radius: 4px; }
.quiz legend { padding: 0 8px; font-size: 18px; line-height: 1.5; }
.quiz label { display: inline-flex; align-items: center; gap: 8px; margin-right: 24px; padding: 10px 0; font-size: 18px; cursor: pointer; }
.quiz input { accent-color: #fff; width: 18px; height: 18px; }
.quiz button { padding: 12px 20px; border: 1px solid #fff; border-radius: 4px; background: #fff; color: #000; font: inherit; font-weight: bold; cursor: pointer; }
.quiz button:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
.quiz button:disabled { opacity: .5; cursor: default; }
.quiz .feedback { margin: 8px 0 0; line-height: 1.5; color: #ddd; }
.quiz output { display: block; margin: 20px 0; font-size: 20px; line-height: 1.5; }
</style>
</head>
<body>
<main>
<section aria-label="Rectangular periodic table"><div class="rect" id="rect"></div><output class="details" aria-live="polite"></output></section>
<section class="circular-section" aria-label="Circular periodic table"><div class="circle" id="circle"></div><output class="details" aria-live="polite"></output></section>
<section class="quiz" aria-label="Four-question true or false quiz">
  <form id="quizForm">
    <div id="quizQuestions"></div>
    <button type="submit" id="checkQuiz">Check answers</button>
    <output id="quizScore" aria-live="polite"></output>
    <button type="button" id="retryQuiz" hidden>Try again</button>
  </form>
</section>
</main>
<script>
const raw=`H Hydrogen|He Helium|Li Lithium|Be Beryllium|B Boron|C Carbon|N Nitrogen|O Oxygen|F Fluorine|Ne Neon|Na Sodium|Mg Magnesium|Al Aluminium|Si Silicon|P Phosphorus|S Sulfur|Cl Chlorine|Ar Argon|K Potassium|Ca Calcium|Sc Scandium|Ti Titanium|V Vanadium|Cr Chromium|Mn Manganese|Fe Iron|Co Cobalt|Ni Nickel|Cu Copper|Zn Zinc|Ga Gallium|Ge Germanium|As Arsenic|Se Selenium|Br Bromine|Kr Krypton|Rb Rubidium|Sr Strontium|Y Yttrium|Zr Zirconium|Nb Niobium|Mo Molybdenum|Tc Technetium|Ru Ruthenium|Rh Rhodium|Pd Palladium|Ag Silver|Cd Cadmium|In Indium|Sn Tin|Sb Antimony|Te Tellurium|I Iodine|Xe Xenon|Cs Caesium|Ba Barium|La Lanthanum|Ce Cerium|Pr Praseodymium|Nd Neodymium|Pm Promethium|Sm Samarium|Eu Europium|Gd Gadolinium|Tb Terbium|Dy Dysprosium|Ho Holmium|Er Erbium|Tm Thulium|Yb Ytterbium|Lu Lutetium|Hf Hafnium|Ta Tantalum|W Tungsten|Re Rhenium|Os Osmium|Ir Iridium|Pt Platinum|Au Gold|Hg Mercury|Tl Thallium|Pb Lead|Bi Bismuth|Po Polonium|At Astatine|Rn Radon|Fr Francium|Ra Radium|Ac Actinium|Th Thorium|Pa Protactinium|U Uranium|Np Neptunium|Pu Plutonium|Am Americium|Cm Curium|Bk Berkelium|Cf Californium|Es Einsteinium|Fm Fermium|Md Mendelevium|No Nobelium|Lr Lawrencium|Rf Rutherfordium|Db Dubnium|Sg Seaborgium|Bh Bohrium|Hs Hassium|Mt Meitnerium|Ds Darmstadtium|Rg Roentgenium|Cn Copernicium|Nh Nihonium|Fl Flerovium|Mc Moscovium|Lv Livermorium|Ts Tennessine|Og Oganesson`.split('|').map((v,i)=>({symbol:v.split(' ')[0],name:v.split(' ')[1],n:i+1}));
function position(n){if(n===1)return[1,1];if(n===2)return[1,18];if(n>=3&&n<=4)return[2,n-2];if(n>=5&&n<=10)return[2,n+8];if(n===11)return[3,1];if(n===12)return[3,2];if(n>=13&&n<=18)return[3,n];if(n<=36)return[4,n-18];if(n<=54)return[5,n-36];if(n===55)return[6,1];if(n===56)return[6,2];if(n===57)return[6,3];if(n>=58&&n<=71)return[8,n-54];if(n>=72&&n<=86)return[6,n-68];if(n===87)return[7,1];if(n===88)return[7,2];if(n===89)return[7,3];if(n>=90&&n<=103)return[9,n-86];return[7,n-100]}
const periodEnds = [2, 10, 18, 36, 54, 86, 118];
const elements = raw.map(e => ({ ...e, period: periodEnds.findIndex(end => e.n <= end) + 1 }));
function selectElement(element) {
  document.querySelectorAll('.element').forEach(button => {
    const selected = Number(button.dataset.n) === element.n;
    button.classList.toggle('selected', selected);
    button.setAttribute('aria-pressed', String(selected));
  });
  const isSeries = (element.n >= 57 && element.n <= 71) || (element.n >= 89 && element.n <= 103);
  const placement = isSeries ? (element.n <= 71 ? 'Lanthanide series' : 'Actinide series') : `Group ${position(element.n)[1]}`;
  document.querySelectorAll('.details').forEach(output => {
    output.textContent = `${element.name} (${element.symbol}) | Atomic number ${element.n} | Period ${element.period} | ${placement}`;
  });
}
function makeButton(element, circular) {
  const button = document.createElement('button');
  button.className = 'element';
  button.dataset.n = element.n;
  button.type = 'button';
  button.setAttribute('aria-label', `${element.name}, atomic number ${element.n}, period ${element.period}`);
  button.setAttribute('aria-pressed', 'false');
  button.title = `${element.name} | ${element.n} | Period ${element.period}`;
  button.innerHTML = `<span class="number">${element.n}</span><span class="symbol">${element.symbol}</span>${circular ? '' : `<span class="name">${element.name}</span>`}`;
  button.addEventListener('click', () => selectElement(element));
  return button;
}
const rect = document.getElementById('rect');
const circle = document.getElementById('circle');
for (const element of elements) {
  const button = makeButton(element, false);
  const [row, column] = position(element.n);
  button.style.gridRow = row;
  button.style.gridColumn = column;
  rect.append(button);
}
// Each ring is one actual period, including the f-block in periods 6 and 7.
// 64px between rings and at least 72px between neighboring outer-ring centers
// leave room for 48px buttons without collisions.
for (let period = 1; period <= 7; period++) {
  const members = elements.filter(element => element.period === period);
  const radius = 64 * period;
  const ring = document.createElement('div');
  ring.className = 'ring';
  ring.style.width = ring.style.height = `${radius * 2}px`;
  circle.append(ring);
  members.forEach((element, index) => {
    const angle = -Math.PI / 2 + index * 2 * Math.PI / members.length;
    const button = makeButton(element, true);
    button.style.left = `${500 + radius * Math.cos(angle)}px`;
    button.style.top = `${500 + radius * Math.sin(angle)}px`;
    circle.append(button);
  });
}
const quizQuestions = [
  { statement: 'Hydrogen (H) is in group 1.', answer: true, explanation: 'Hydrogen is in group 1.' },
  { statement: 'Oxygen (O) is in period 3.', answer: false, explanation: 'Oxygen is in period 2.' },
  { statement: 'Sodium (Na) is in group 2.', answer: false, explanation: 'Sodium is in group 1.' },
  { statement: 'Neon (Ne) is in period 2.', answer: true, explanation: 'Neon is in period 2.' }
];
const quizForm = document.getElementById('quizForm');
const quizScore = document.getElementById('quizScore');
const checkQuiz = document.getElementById('checkQuiz');
const retryQuiz = document.getElementById('retryQuiz');
document.getElementById('quizQuestions').innerHTML = quizQuestions.map((question, index) => `
  <fieldset>
    <legend>${index + 1} of 4. ${question.statement}</legend>
    <label><input type="radio" name="question${index}" value="true" required>True</label>
    <label><input type="radio" name="question${index}" value="false" required>False</label>
    <p class="feedback" id="feedback${index}" hidden></p>
  </fieldset>
`).join('');
quizForm.addEventListener('submit', event => {
  event.preventDefault();
  if (checkQuiz.disabled || !quizForm.reportValidity()) return;
  const answers = new FormData(quizForm);
  let score = 0;
  quizQuestions.forEach((question, index) => {
    const correct = answers.get(`question${index}`) === String(question.answer);
    if (correct) score++;
    const feedback = document.getElementById(`feedback${index}`);
    feedback.textContent = `${correct ? 'Correct!' : 'Not quite.'} ${question.explanation}`;
    feedback.hidden = false;
  });
  quizScore.textContent = `You scored ${score} out of 4.${score === 4 ? ' Nice work!' : ' Review the answers and try again.'}`;
  quizForm.querySelectorAll('input').forEach(input => { input.disabled = true; });
  checkQuiz.disabled = true;
  retryQuiz.hidden = false;
});
retryQuiz.addEventListener('click', () => {
  quizForm.reset();
  quizForm.querySelectorAll('input').forEach(input => { input.disabled = false; });
  quizForm.querySelectorAll('.feedback').forEach(feedback => { feedback.hidden = true; feedback.textContent = ''; });
  quizScore.textContent = '';
  checkQuiz.disabled = false;
  retryQuiz.hidden = true;
  quizForm.querySelector('input').focus();
});
</script>
</body>
</html>
